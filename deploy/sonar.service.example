[Unit]
Description=Sonar — Local Offline AI Memory Service (FTS5 + INT8 Vector Scan + Cross-Encoder)
After=local-fs.target

[Service]
Type=simple
User=sonar
Group=sonar
RuntimeDirectory=sonar
RuntimeDirectoryMode=0750
UMask=0077
Environment=HOME=/var/lib/sonar
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/node --expose-gc /opt/sonar/server/mcp-server.mjs /etc/sonar/config.json
MemoryHigh=1800M
MemoryMax=2800M
CPUWeight=60
IOWeight=60
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sonar /run/sonar
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
